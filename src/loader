--========================================================--
-- LOCAL FILE PERSISTENCE
--========================================================--

local function GetFileAPI()

    local available = {

        isfile =
            type(isfile) == "function",

        readfile =
            type(readfile) == "function",

        writefile =
            type(writefile) == "function",

        delfile =
            type(delfile) == "function"

    }

    return available

end


local function ReadSavedKey()

    local api =
        GetFileAPI()


    if not api.isfile
        or not api.readfile then

        Log(
            "Workspace persistence tidak tersedia."
        )

        return nil

    end


    local existsOK,
        exists =
        pcall(function()

            return isfile(
                CONFIG.KEY_FILE
            )

        end)


    if not existsOK
        or not exists then

        return nil

    end


    local readOK,
        saved =
        pcall(function()

            return readfile(
                CONFIG.KEY_FILE
            )

        end)


    if not readOK then

        LogError(
            "Gagal membaca saved key."
        )

        return nil

    end


    saved =
        tostring(
            saved or ""
        )


    saved =
        saved:gsub(
            "^%s+",
            ""
        ):gsub(
            "%s+$",
            ""
        )


    if saved == "" then

        return nil

    end


    return saved

end


local function SaveKey(key)

    local api =
        GetFileAPI()


    if not api.writefile then

        Log(
            "writefile tidak tersedia; key tidak disimpan."
        )

        return false

    end


    local ok,
        err =
        pcall(function()

            writefile(
                CONFIG.KEY_FILE,
                tostring(key)
            )

        end)


    if not ok then

        LogError(
            "Gagal menyimpan key: " ..
            tostring(err)
        )

        return false

    end


    Log(
        "Key berhasil disimpan ke workspace."
    )

    return true

end


local function DeleteSavedKey()

    local api =
        GetFileAPI()


    if not api.delfile
        or not api.isfile then

        return false

    end


    local existsOK,
        exists =
        pcall(function()

            return isfile(
                CONFIG.KEY_FILE
            )

        end)


    if not existsOK
        or not exists then

        return true

    end


    local ok,
        err =
        pcall(function()

            delfile(
                CONFIG.KEY_FILE
            )

        end)


    if not ok then

        LogError(
            "Gagal menghapus saved key: " ..
            tostring(err)
        )

        return false

    end


    Log(
        "Saved key dihapus."
    )

    return true

end


--========================================================--
-- HTTP
--========================================================--

local function GetRequestFunction()

    if type(request) == "function" then
        return request
    end

    if type(http_request) == "function" then
        return http_request
    end

    if syn
        and type(syn.request) == "function" then

        return syn.request
    end

    return nil

end


local function HttpGet(url)

    if type(game.HttpGet) == "function" then

        return game:HttpGet(url)

    end


    local requestFunction =
        GetRequestFunction()


    if not requestFunction then

        error(
            "HTTP GET tidak tersedia."
        )

    end


    local response =
        requestFunction({

            Url = url,

            Method = "GET"

        })


    if type(response) ~= "table" then

        error(
            "Response HTTP tidak valid."
        )

    end


    local status =
        tonumber(
            response.StatusCode or 0
        ) or 0


    if status < 200
        or status >= 300 then

        error(
            "HTTP " ..
            tostring(status)
        )

    end


    return tostring(
        response.Body or ""
    )

end


--========================================================--
-- LOAD REMOTE MODULE
--========================================================--

local function LoadRemoteModule(
    name,
    url
)

    Log(
        "Loading " ..
        name ..
        "..."
    )


    local ok,
        source =
        pcall(function()

            return HttpGet(url)

        end)


    if not ok then

        return false,
            nil,
            "Download gagal: " ..
            tostring(source)

    end


    if type(source) ~= "string"
        or source == "" then

        return false,
            nil,
            name ..
            " kosong."

    end


    local compileOK,
        fn =
        pcall(function()

            local compiled,
                compileError =
                loadstring(source)


            if not compiled then

                error(
                    tostring(
                        compileError
                    )
                )

            end


            return compiled

        end)


    if not compileOK then

        return false,
            nil,
            "Compile " ..
            name ..
            " gagal: " ..
            tostring(fn)

    end


    return true,
        fn,
        nil

end


