--========================================================--
-- MAIN SOURCE
--========================================================--

local mainStarted = false


local function StartMainSource()

    if mainStarted then
        return
    end


    mainStarted = true


    Log(
        "Key valid."
    )

    Log(
        "Loading Main Source..."
    )


    local mainOK,
        mainLoader,
        mainError =
        LoadRemoteModule(
            "Main Source",
            CONFIG.MAIN_SOURCE_URL
        )


    if not mainOK then

        mainStarted = false

        LogError(mainError)

        return

    end


    Log(
        "Main Source downloaded."
    )


    local executeOK,
        result =
        xpcall(

            function()

                return mainLoader()

            end,

            function(err)

                return tostring(err)

            end

        )


    if not executeOK then

        mainStarted = false

        LogError(
            "Main Source error:"
        )

        LogError(result)

        return

    end


    Log(
        "Main Source started."
    )

end


--========================================================--
-- KEY SYSTEM UI
--========================================================--

local function StartKeyUI(autoKey)

    local gateOK,
        gateResult =
        pcall(function()

            return KeySystem:Start({

                UILibrary =
                    UILibrary,

                Title =
                    CONFIG.KEY_TITLE,

                Subtitle =
                    CONFIG.KEY_SUBTITLE,

                OnVerified =
                    function(info)

                        local enteredKey =
                            info.key


                        if not enteredKey then

                            LogError(
                                "Key valid tetapi key tidak dikembalikan oleh Key System."
                            )

                            return

                        end


                        SaveKey(
                            enteredKey
                        )


                        pcall(function()

                            if type(getgenv) == "function"
                                and tostring(
                                    getgenv().PHILANX_REDEEMED_KEY
                                    or ""
                                ) == tostring(enteredKey) then

                                getgenv().PHILANX_REDEEMED_KEY =
                                    nil

                            end

                        end)


                        Log(
                            "KEY VERIFIED"
                        )


                        Log(
                            "Action: " ..
                            tostring(
                                info.action
                            )
                        )


                        Log(
                            "Status: " ..
                            tostring(
                                info.status
                            )
                        )


                        Log(
                            "Expires: " ..
                            tostring(
                                info.expiresAt
                            )
                        )


                        task.spawn(
                            StartMainSource
                        )

                    end,

                OnFailed =
                    function(reason)

                        LogError(
                            "Key rejected: " ..
                            tostring(reason)
                        )

                    end

            })

        end)


    if not gateOK then

        LogError(
            "Key System gagal dijalankan:"
        )

        LogError(
            gateResult
        )

        return false

    end


    --========================================================--
    -- AUTO REDEEM KEY
    --========================================================--
    --
    -- Redeemed key menggunakan jalur verifikasi normal.
    -- Key dimasukkan otomatis ke input lalu Verify()
    -- dijalankan.
    --
    if autoKey then

        if type(gateResult) == "table" then

            local input =
                gateResult.Input

            local verify =
                gateResult.Verify


            if input then

                input.Text =
                    tostring(autoKey)

            end


            if type(verify) == "function" then

                task.defer(function()

                    local ok,
                        verifyResult =
                        pcall(
                            verify
                        )


                    if not ok then

                        LogError(
                            "Auto redeem Verify error: " ..
                            tostring(
                                verifyResult
                            )
                        )

                    end

                end)

            else

                LogError(
                    "Auto redeem: API Verify tidak tersedia."
                )

            end

        else

            LogError(
                "Auto redeem: KeySystem:Start() tidak mengembalikan API."
            )

        end

    end


    return true

end


--========================================================--
-- SAVED KEY VERIFICATION
--========================================================--

local function VerifySavedKey(
    savedKey
)

    Log(
        "Saved key ditemukan."
    )

    Log(
        "Memverifikasi saved key..."
    )


    if type(
        KeySystem.VerifySavedKey
    ) ~= "function" then

        Log(
            "Key System belum menyediakan VerifySavedKey."
        )

        return false,
            "unsupported"

    end


    local ok,
        valid,
        result =
        pcall(function()

            return KeySystem:VerifySavedKey(
                savedKey
            )

        end)


    if not ok then

        LogError(
            "Saved key verification error: " ..
            tostring(valid)
        )

        return false,
            "error"

    end


    if valid ~= true then

        local reason =
            type(result) == "table"
            and (
                result.reason
                or result.error
            )
            or "invalid"


        return false,
            tostring(reason)

    end


    if type(result) ~= "table" then

        return false,
            "invalid_response"

    end


    return true,
        result

end


--========================================================--
-- REDEEMED KEY
--========================================================--

local function GetRedeemedKey()

    local ok,
        value =
        pcall(function()

            if type(getgenv) == "function" then

                return getgenv().PHILANX_REDEEMED_KEY

            end


            return nil

        end)


    if not ok then

        return nil

    end


    value =
        tostring(
            value or ""
        )


    value =
        value:gsub(
            "^%s+",
            ""
        ):gsub(
            "%s+$",
            ""
        )


    if value == "" then

        return nil

    end


    return value

end


local function ClearRedeemedKey()

    pcall(function()

        if type(getgenv) == "function" then

            getgenv().PHILANX_REDEEMED_KEY =
                nil

        end

    end)

end


