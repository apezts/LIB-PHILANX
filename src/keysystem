local HttpService = game:GetService("HttpService")

local KeySystem = {}

local API_URL =
    "https://script.google.com/macros/s/AKfycbxhim11KSL2Wu-4R5dyXw07UFlSptHprPQwonAtDlEtqkPuhe8a43EVQaKC0KrdHfrs/exec"


--========================================================--
-- HTTP
--========================================================--

local function GetRequestFunction()

    if type(request) == "function" then
        return request
    end

    if type(http_request) == "function" then
        return http_request
    end

    if syn and type(syn.request) == "function" then
        return syn.request
    end

    return nil
end


local function SendRequest(body)

    local requestFunction =
        GetRequestFunction()

    if not requestFunction then
        return false, {
            error =
                "Fungsi HTTP request tidak tersedia."
        }
    end


    local encoded

    local encodeOK, encodeResult =
        pcall(function()
            return HttpService:JSONEncode(body)
        end)


    if not encodeOK then
        return false, {
            error = "Gagal membuat JSON request."
        }
    end


    encoded = encodeResult


    local requestOK, response =
        pcall(function()

            return requestFunction({
                Url = API_URL,

                Method = "POST",

                Headers = {
                    ["Content-Type"] =
                        "application/json"
                },

                Body = encoded
            })

        end)


    if not requestOK then

        return false, {
            error =
                "Gagal menghubungi server."
        }

    end


    if type(response) ~= "table" then

        return false, {
            error =
                "Response server tidak valid."
        }

    end


    local statusCode =
        tonumber(
            response.StatusCode
        ) or 0


    if statusCode < 200
        or statusCode >= 300 then

        return false, {
            error =
                "HTTP " ..
                tostring(statusCode)
        }

    end


    local raw =
        tostring(
            response.Body or ""
        )


    local decodeOK, result =
        pcall(function()

            return HttpService:JSONDecode(
                raw
            )

        end)


    if not decodeOK
        or type(result) ~= "table" then

        return false, {
            error =
                "Response server bukan JSON valid."
        }

    end


    return true, result

end


--========================================================--
-- HWID
--========================================================--

local function GetDeviceIdentifier()

    if type(gethwid) ~= "function" then

        return nil,
            "gethwid tidak tersedia pada executor."

    end


    local ok, result =
        pcall(gethwid)


    if not ok then

        return nil,
            "Gagal mendapatkan HWID."

    end


    result =
        tostring(result or "")


    if result == "" then

        return nil,
            "HWID kosong."

    end


    return result

end


--========================================================--
-- KEY NORMALIZATION
--========================================================--

local function NormalizeKey(value)

    value =
        tostring(value or "")

    value =
        value:gsub(
            "^%s+",
            ""
        )

    value =
        value:gsub(
            "%s+$",
            ""
        )

    return string.upper(value)

end


--========================================================--
-- ERROR MESSAGE
--========================================================--

local ErrorMessages = {

    not_found =
        "Key tidak ditemukan.",

    revoked =
        "Key telah dinonaktifkan.",

    expired =
        "Key telah kedaluwarsa.",

    inactive =
        "Key tidak aktif.",

    hwid_mismatch =
        "Key sudah terikat ke perangkat lain.",

    missing_key =
        "Masukkan key terlebih dahulu.",

    identifier_error =
        "HWID tidak dapat diperoleh.",

    request_error =
        "Gagal menghubungi server."

}


